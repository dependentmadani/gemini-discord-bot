TOKEN=<discord bot token>
OPENROUTER_API_KEY=<generate api key from openrouter.ai>
# Optional: single model id or comma-separated priority list.
# Leave unset to use the built-in cheap-paid-model fallback chain.
# OPENROUTER_MODEL=inclusionai/ling-2.6-flash,mistralai/mistral-nemo
CHANNEL_ID=<discord channel_id>
# Optional: override the bot's personality. Leave unset for the default witty,
# playful vibe.
# SYSTEM_PROMPT=You are a chill, friendly assistant who keeps replies short.
